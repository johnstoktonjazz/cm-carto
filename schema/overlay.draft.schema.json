{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cm-carto/overlay-draft/0.1",
  "title": "Слои данных карты в миллиметрах места макета (<карта>.overlay.json)",
  "description": "Черновик картографа до контракта overlay Романа в cm-contracts. Все, что на карте, кроме подложки, — для редактируемой отрисовки в PowerPoint. Координаты — мм места: начало в левом верхнем углу, x вправо, y вниз. Стиль (цвет, толщина, шрифт, размер знака) не пишется: он по role из cm-design/tokens/map.yaml.",
  "type": "object",
  "required": ["format", "units", "origin", "y_axis", "size_mm", "basemap", "stack", "crs", "scale", "extent",
               "features", "labels", "legend", "scale_bar", "north"],
  "additionalProperties": false,
  "$defs": {
    "xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "align": {"enum": ["top-left", "top-center", "top-right", "middle-left", "center", "middle-right",
                       "bottom-left", "bottom-center", "bottom-right"]},
    "position": {
      "type": "object",
      "required": ["x", "y", "align"],
      "additionalProperties": false,
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "align": {"$ref": "#/$defs/align"}},
      "description": "точка элемента компоновки map_<место>.qpt верстки и какой угол элемента в ней стоит"
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["Point", "LineString", "MultiLineString", "Polygon", "MultiPolygon", "GeometryCollection"]},
        "coordinates": {"type": "array"}
      },
      "description": "как GeoJSON, в мм места; полигон — внешнее кольцо и дыры; обрезано по рамке места, упрощено с допуском 0,1 мм, сетка 0,01 мм"
    }
  },
  "properties": {
    "format": {"const": "cm-carto/overlay-draft/0.1"},
    "units": {"const": "mm"},
    "origin": {"const": "top-left"},
    "y_axis": {"const": "down"},
    "size_mm": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {"width": {"type": "number"}, "height": {"type": "number"}},
      "description": "размер места (map.yaml: places.<место>.image), равен размеру подложки"
    },
    "basemap": {"type": "string", "description": "подложка PNG рядом (у нее *.provenance.json по контракту image)"},
    "stack": {
      "type": "array",
      "minItems": 1,
      "description": "порядок отрисовки снизу вверх: картинки подложки и группы ролей overlay; верхние картинки подложки — с прозрачным фоном",
      "items": {
        "type": "object",
        "required": ["kind", "roles"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["basemap", "overlay"]},
          "roles": {"type": "array", "items": {"type": "string"}, "description": "роли снизу вверх"},
          "file": {"type": "string", "description": "у basemap — картинка"}
        }
      }
    },
    "crs": {"type": "string", "description": "система координат проекта (crs.name анкеты)"},
    "scale": {"type": "integer", "description": "знаменатель масштаба при печати в размер места"},
    "extent": {
      "type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
      "description": "охват места [xmin, ymin, xmax, ymax] в crs: мм → проект x = xmin + x_mm·scale/1000, y = ymax − y_mm·scale/1000"
    },
    "features": {
      "type": "array",
      "description": "объекты ролей уровней analysis, objects, boundaries в порядке отрисовки снизу вверх, внутри роли — по object_id",
      "items": {
        "type": "object",
        "required": ["role", "object_id", "status", "fact_ids", "geometry"],
        "properties": {
          "role": {"type": "string", "description": "ключ map.yaml: layers или zoning; стиль — по нему"},
          "object_id": {"type": "string"},
          "status": {"enum": ["official", "cadastral", "digitized", "concept", "reference"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "geometry": {"$ref": "#/$defs/geometry"},
          "marker": {
            "type": "object",
            "required": ["shape", "token"],
            "additionalProperties": false,
            "properties": {"shape": {"enum": ["circle", "square"]}, "token": {"type": "string"}},
            "description": "точечный знак: форма и ключ токена с размером, заливкой и обводкой"
          }
        },
        "additionalProperties": {"type": "string", "description": "у зон — поле категории (zone) и индекс (code)"}
      }
    },
    "labels": {
      "type": "array",
      "description": "подписи объектов по правилам стиля роли (max_features, min_size); размещение — по точке привязки, без разведения конфликтов",
      "items": {
        "type": "object",
        "required": ["role", "object_id", "text", "style", "placement", "anchor", "align"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string"},
          "object_id": {"type": "string"},
          "text": {"type": "string"},
          "style": {"type": "string", "description": "map.yaml: text.styles.<стиль>; плашка — text.plate, перенос — text.wrap_chars"},
          "placement": {"enum": ["around", "center", "centroid", "along"]},
          "anchor": {"$ref": "#/$defs/xy"},
          "align": {"$ref": "#/$defs/align", "description": "какой угол рамки текста стоит в anchor"},
          "angle": {"type": "number", "description": "у подписи вдоль линии: градусы против часовой от горизонтали"}
        }
      }
    },
    "legend": {
      "type": "object",
      "required": ["place", "rows"],
      "additionalProperties": false,
      "properties": {
        "place": {"type": ["integer", "string"], "description": "ширина места легенды, мм, или inside"},
        "position": {"$ref": "#/$defs/position"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "text", "level"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["group", "heading", "item"], "description": "group — заголовок уровня (с groups_from строк), heading — имя слоя с категориями, item — строка с образцом"},
              "text": {"type": "string"},
              "level": {"type": "string"},
              "role": {"type": "string", "description": "образец — по стилю роли"},
              "category": {"type": "string", "description": "у категорий (zoning) — значение поля категории"}
            }
          }
        }
      }
    },
    "scale_bar": {
      "type": "object",
      "required": ["segment_mm", "segments", "length_mm", "labels", "position"],
      "additionalProperties": false,
      "properties": {
        "segment_mm": {"type": "number"},
        "segments": {"type": "integer"},
        "length_mm": {"type": "number"},
        "labels": {"type": "array", "items": {"type": "string"}, "description": "подписи делений слева направо; стиль — map.yaml: scale_bar"},
        "position": {"$ref": "#/$defs/position"}
      }
    },
    "north": {
      "type": "object",
      "required": ["visible", "position"],
      "additionalProperties": false,
      "properties": {"visible": {"type": "boolean"}, "position": {"$ref": "#/$defs/position"}}
    }
  }
}
